# Work Calendar - environment variables.
#
# Copy to `.env` (or `.env.local`) and fill in real values for your stage.
# Schema lives in `src/lib/env.ts` - the app fails fast on boot if a required
# value is missing or malformed.
#
# Anything marked "optional" can be left blank; the corresponding feature is
# disabled gracefully. Anything required is marked REQUIRED.


# ─────────────────────────────────────────────────────────────────────────────
# Core (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Postgres connection string. `docker compose up db` provisions:
#   postgres://postgres:postgres@localhost:5432/work_calendar
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/work_calendar?schema=public"

# REQUIRED — Public URL of the app. Used by NextAuth callbacks and ICS feed
# absolute URLs. Set to the production hostname in prod, including scheme.
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED — ≥32 chars. Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-me-with-a-long-random-string-32-chars-min"


# ─────────────────────────────────────────────────────────────────────────────
# OAuth (optional) — sign-in with Google
# ─────────────────────────────────────────────────────────────────────────────

# Both required together. Leave unset to disable the "Sign in with Google"
# button. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (optional) — Resend
# ─────────────────────────────────────────────────────────────────────────────

# When either is missing, email notifications are silently no-ops. Useful in
# dev / CI. In production set both to actually deliver invites and decisions.
RESEND_API_KEY=""
EMAIL_FROM="Work Calendar <noreply@yourdomain.com>"


# ─────────────────────────────────────────────────────────────────────────────
# Web Push notifications (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Set ALL THREE to enable push. Generate VAPID keys with:
#   npx web-push generate-vapid-keys
# `VAPID_SUBJECT` must be a mailto: link or https URL (RFC 8292).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@yourdomain.com"


# ─────────────────────────────────────────────────────────────────────────────
# Belgian Dimona / ONSS adapter (optional)
# ─────────────────────────────────────────────────────────────────────────────

# `mock` (default) — no network calls, logs intended declarations.
# `sandbox` — calls DIMONA_SANDBOX_URL with DIMONA_TOKEN.
# `prod` — calls DIMONA_PROD_URL with DIMONA_TOKEN.
DIMONA_ENV="mock"
DIMONA_SANDBOX_URL=""
DIMONA_PROD_URL=""
DIMONA_TOKEN=""

# AES-256-GCM key used to encrypt Business.dimonaCredentials at rest.
# Any 32+ char string works (it is hashed with SHA-256 internally). REQUIRED
# in production if you store per-business Dimona credentials; in dev a
# placeholder is used automatically.
DIMONA_ENCRYPTION_KEY=""


# ─────────────────────────────────────────────────────────────────────────────
# Object storage for document uploads (optional) — S3-compatible
# ─────────────────────────────────────────────────────────────────────────────

# Set ALL FIVE to enable the document-upload UI. Works with AWS S3, Cloudflare
# R2, MinIO, Backblaze B2, etc.
#
# Cloudflare R2 example:
#   STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_FORCE_PATH_STYLE=false
#
# AWS S3 example:
#   STORAGE_ENDPOINT=https://s3.eu-west-1.amazonaws.com
#   STORAGE_REGION=eu-west-1
#   STORAGE_FORCE_PATH_STYLE=false
#
# MinIO / dev example (matches docker-compose minio service):
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_REGION=us-east-1
#   STORAGE_BUCKET=tg-uploads
#   STORAGE_ACCESS_KEY=minioadmin
#   STORAGE_SECRET_KEY=minioadmin
#   STORAGE_FORCE_PATH_STYLE=true
# Then run: npm run storage:init
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_FORCE_PATH_STYLE="false"
# Optional: extra browser origins for MinIO global CORS (comma-separated)
# STORAGE_CORS_ORIGINS="https://app.example.com"
# Written automatically by `npm run storage:setup` from NEXTAUTH_URL + defaults:
# MINIO_API_CORS_ALLOW_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# Optional: allow anonymous read on the bucket (auto-enabled for localhost)
# STORAGE_PUBLIC_READ="true"


# ─────────────────────────────────────────────────────────────────────────────
# Observability (optional)
# ─────────────────────────────────────────────────────────────────────────────

# Set SENTRY_DSN to enable error reporting. Sample rate is the fraction of
# transactions captured (0..1); defaults to 0.1 when unset.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# fatal | error | warn | info | debug | trace
LOG_LEVEL="info"


# ─────────────────────────────────────────────────────────────────────────────
# CI / build flags (rarely set by hand)
# ─────────────────────────────────────────────────────────────────────────────

# Set to "1" to skip env-schema parsing - used by `next build` in CI when env
# is only injected at runtime.
# SKIP_ENV_VALIDATION="1"
