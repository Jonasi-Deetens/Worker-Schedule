generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  WORKER
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ContractType {
  FLEXI
  JOBSTUDENT
  EMPLOYEE
  EXTRA
}

enum StudentRegion {
  FLANDERS
  BRUSSELS
  WALLONIA
  EAST_BELGIUM
}

enum ShiftStatus {
  OPEN
  PENDING
  FILLED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  NEW_SUBSCRIPTION
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  APPLICATION_WITHDRAWN
  SHIFT_CANCELLED
  INVITE_ACCEPTED
  SHIFT_ASSIGNED
  TIMEOFF_DECIDED
  SHIFT_REMINDER_24H
  SHIFT_SWAP_REQUESTED
  SHIFT_SWAP_DECIDED
  SHIFT_BROADCAST
  SHIFT_RESCHEDULED
  TIME_ENTRY_SUBMITTED
  TIME_ENTRY_APPROVED
  TIME_ENTRY_REJECTED
  TIME_ENTRY_CORRECTED
  DIMONA_GAP_DETECTED
  CONTRACT_SENT
  CONTRACT_WORKER_SIGNED
  CONTRACT_FULLY_SIGNED
}

enum AssignmentStatus {
  CONFIRMED
  PENDING_RECONFIRMATION
  PENDING_ACCEPTANCE
}

enum AttendanceStatus {
  ON_TIME
  LATE
  NO_SHOW
  EXCUSED
}

enum AuditAction {
  SHIFT_CREATED
  SHIFT_UPDATED
  SHIFT_DELETED
  SHIFT_PUBLISHED
  SHIFT_ASSIGNED
  SUBSCRIPTION_APPLIED
  SUBSCRIPTION_APPROVED
  SUBSCRIPTION_REJECTED
  SUBSCRIPTION_WITHDRAWN
  AVAILABILITY_SET
  AVAILABILITY_DELETED
  INVITE_SENT
  INVITE_ACCEPTED
  WORKER_SUSPENDED
  WORKER_REACTIVATED
  WORKER_ARCHIVED
  TIMEOFF_REQUESTED
  TIMEOFF_APPROVED
  TIMEOFF_REJECTED
  TIMEOFF_CANCELLED
  TIMEOFF_UPDATED
  TIMEOFF_REVOKED
  SWAP_REQUESTED
  SWAP_DECIDED
  TIME_ENTRY_APPROVED
  TIME_ENTRY_REJECTED
  TIME_ENTRY_EDITED
  DIMONA_DECLARED
  DIMONA_CANCELLED
  DIMONA_OUT_DECLARED
  CONTRACT_SENT
  CONTRACT_SIGNED
  CONTRACT_WORKER_SIGNED
  CONTRACT_EMPLOYER_SIGNED
  CONTRACT_DECLINED
  WORKER_PROFILE_UPDATED
  BUSINESS_SETTINGS_UPDATED
  ATTENDANCE_MARKED
  SHIFT_BROADCAST_SENT
  SHIFT_RESCHEDULE_PENDING
  SHIFT_RECONFIRMED
  SHIFT_RECONFIRM_DECLINED
  SHIFT_ASSIGNMENT_ACCEPTED
  SHIFT_ASSIGNMENT_DECLINED
  GDPR_DELETE_REQUESTED
  GDPR_PURGED
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DimonaStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum TimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractStatus {
  DRAFT
  SENT
  WORKER_SIGNED
  SIGNED
  DECLINED
}

model Business {
  id                String   @id @default(cuid())
  name              String
  ownerId           String   @unique
  owner             User     @relation("BusinessOwner", fields: [ownerId], references: [id])
  timezone          String   @default("Europe/Brussels")
  weekStartsOn      Int      @default(1)
  dimonaCredentials String?
  dimonaEmployerId  String?
  requireSignedContract Boolean @default(false)
  // Real employer identification used by contracts + Dimona declarations.
  addressLine       String?
  postalCode        String?
  city              String?
  cbeNumber         String?
  // Fillable PDF contract templates (AcroForm) per locale — auto-filled on send.
  contractTemplateUrlNl String?
  contractTemplateUrlFr String?
  // When true, blocks JOBSTUDENT assignments that would exceed the 650h quota.
  studentQuotaHardStop Boolean @default(false)
  // Safety margin (hours) subtracted from the 650h cap before the hard stop
  // trips, so a business can stop scheduling students a little before the cap.
  studentQuotaHardStopBufferHours Int @default(0)
  // When true, a JOBSTUDENT cannot be assigned without a non-stale Student@Work
  // attestation on file; staleness is measured against `attestationMaxAgeDays`.
  requireStudentAttestation Boolean @default(false)
  // Maximum age (days) of a Student@Work attestation before it counts as stale.
  attestationMaxAgeDays Int @default(365)
  // When true, shift-linked clock-in requires the worker to be physically
  // inside the shift location's geofence (optional, off by default).
  enforceGeofence   Boolean @default(false)
  revenueWeeklyJson Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workers     User[]                @relation("BusinessWorkers")
  shifts      Shift[]
  templates   ShiftTemplate[]
  skills      Skill[]
  invites     Invite[]
  rosters     RosterTemplate[]
  locations   Location[]
  memberships Membership[]
  apiKeys     ApiKey[]
  webhooks    WebhookSubscription[]
  contracts   WorkerContract[]
  stuDeclarations DimonaStuDeclaration[]
  studentQuotas   StudentQuota[]
  holidays        Holiday[]

  @@map("businesses")
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  passwordHash      String
  name              String
  role              UserRole
  status            UserStatus    @default(ACTIVE)
  phone             String?
  avatarUrl         String?
  locale            String        @default("en")
  contractType      ContractType?
  hourlyRate        Decimal?      @db.Decimal(10, 2)
  currency          String        @default("EUR")
  weeklyHourCap     Int?
  birthDate         DateTime?
  notificationPrefs Json?
  twoFactorSecret   String?
  nationalNumber    String?
  addressLine       String?
  postalCode        String?
  city              String?
  iban              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  region            StudentRegion?
  icsRotation       Int           @default(0)
  businessId        String?
  business          Business?     @relation("BusinessWorkers", fields: [businessId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  ownedBusiness         Business?              @relation("BusinessOwner")
  availabilities        Availability[]
  availabilityTemplates AvailabilityTemplate[]
  subscriptions         ShiftSubscription[]
  assignments           ShiftAssignment[]      @relation("AssignmentWorker")
  attendanceReviews     ShiftAssignment[]      @relation("AssignmentReviewer")
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  auditEvents           AuditEvent[]
  invitesSent           Invite[]               @relation("InviteSentBy")
  skills                UserSkill[]
  timeOffRequests       TimeOffRequest[]       @relation("TimeOffRequester")
  timeOffDecisions      TimeOffRequest[]       @relation("TimeOffDecider")
  timeEntries           TimeEntry[]            @relation("TimeEntryUser")
  timeEntryReviews      TimeEntry[]            @relation("TimeEntryReviewer")
  swapsRequested        ShiftSwap[]            @relation("SwapTarget")
  documents             Document[]
  workerContracts       WorkerContract[]
  shiftMessages         ShiftMessage[]
  memberships           Membership[]
  passwordResetTokens   PasswordResetToken[]
  stuDeclarations       DimonaStuDeclaration[]
  studentQuotas         StudentQuota[]

  @@index([businessId])
  @@index([status])
  @@map("users")
}

model Shift {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId      String?
  location        Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  startsAt        DateTime
  endsAt          DateTime
  roleLabel       String
  requiredSpots   Int            @default(1)
  notes           String?
  status          ShiftStatus    @default(OPEN)
  publishedAt     DateTime?
  publishedById   String?
  requiredSkillId String?
  requiredSkill   Skill?         @relation(fields: [requiredSkillId], references: [id], onDelete: SetNull)
  recurrenceRule  String?
  templateId      String?
  template        ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reminderSentAt  DateTime?
  broadcastAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions      ShiftSubscription[]
  assignments        ShiftAssignment[]
  timeEntries        TimeEntry[]
  messages           ShiftMessage[]
  dimonaDeclarations DimonaDeclaration[]

  @@index([businessId, startsAt, endsAt])
  @@index([templateId])
  @@index([publishedAt])
  @@index([locationId])
  @@map("shifts")
}

model ShiftTemplate {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  roleLabel     String
  requiredSpots Int      @default(1)
  defaultStart  String
  defaultEnd    String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shifts Shift[]

  @@index([businessId])
  @@map("shift_templates")
}

model Availability {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startsAt, endsAt])
  @@map("availabilities")
}

model ShiftSubscription {
  id        String             @id @default(cuid())
  shiftId   String
  shift     Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  swaps ShiftSwap[] @relation("SwapFromSubscription")

  @@unique([shiftId, userId])
  @@index([shiftId, status])
  @@index([userId, status])
  @@map("shift_subscriptions")
}

model ShiftAssignment {
  id                   String            @id @default(cuid())
  shiftId              String
  shift                Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId               String
  user                 User              @relation("AssignmentWorker", fields: [userId], references: [id], onDelete: Cascade)
  status               AssignmentStatus  @default(CONFIRMED)
  attendance           AttendanceStatus?
  attendanceNote       String?
  attendanceMarkedAt   DateTime?
  attendanceMarkedById String?
  attendanceMarkedBy   User?             @relation("AssignmentReviewer", fields: [attendanceMarkedById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())

  @@unique([shiftId, userId])
  @@index([userId])
  @@index([userId, status])
  @@index([attendance])
  @@map("shift_assignments")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditEvent {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model Invite {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String?
  token       String    @unique
  role        UserRole  @default(WORKER)
  invitedById String
  invitedBy   User      @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([expiresAt])
  @@map("invites")
}

model Skill {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  color      String   @default("#6366f1")
  createdAt  DateTime @default(now())

  workers UserSkill[]
  shifts  Shift[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("skills")
}

model UserSkill {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model TimeOffRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("TimeOffRequester", fields: [userId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  status      TimeOffStatus @default(PENDING)
  decidedById String?
  decidedBy   User?         @relation("TimeOffDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([startsAt, endsAt])
  @@map("time_off_requests")
}

model AvailabilityTemplate {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("availability_templates")
}

model TimeEntry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  shiftId      String?
  shift        Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  clockInAt    DateTime
  clockOutAt   DateTime?
  breakMinutes Int             @default(0)
  // Coordinates captured at clock-in when geofence enforcement is enabled.
  clockInLat   Decimal?        @db.Decimal(10, 7)
  clockInLng   Decimal?        @db.Decimal(10, 7)
  status       TimeEntryStatus @default(PENDING)
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?           @relation("TimeEntryReviewer", fields: [approvedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  corrections  TimeEntryCorrection[]

  @@index([userId, clockInAt])
  @@index([shiftId])
  @@index([status])
  @@map("time_entries")
}

/**
 * Append-only audit trail of manager edits to a {@link TimeEntry}. Time
 * registration is immutable: instead of silently overwriting hours, every
 * correction is preserved here with the mandatory reason and a full
 * before/after snapshot so the original registration can always be reconstructed.
 */
model TimeEntryCorrection {
  id               String    @id @default(cuid())
  timeEntryId      String
  timeEntry        TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  editedById       String
  editedAt         DateTime  @default(now())
  reason           String
  prevClockInAt    DateTime
  prevClockOutAt   DateTime?
  prevBreakMinutes Int
  newClockInAt     DateTime
  newClockOutAt    DateTime?
  newBreakMinutes  Int
  createdAt        DateTime  @default(now())

  @@index([timeEntryId])
  @@map("time_entry_corrections")
}

model ShiftSwap {
  id                 String            @id @default(cuid())
  fromSubscriptionId String
  fromSubscription   ShiftSubscription @relation("SwapFromSubscription", fields: [fromSubscriptionId], references: [id], onDelete: Cascade)
  toUserId           String
  toUser             User              @relation("SwapTarget", fields: [toUserId], references: [id], onDelete: Cascade)
  status             SwapStatus        @default(PENDING)
  decidedAt          DateTime?
  message            String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([fromSubscriptionId])
  @@index([toUserId, status])
  @@map("shift_swaps")
}

model RosterTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shifts RosterTemplateShift[]

  @@index([businessId])
  @@map("roster_templates")
}

model RosterTemplateShift {
  id            String         @id @default(cuid())
  rosterId      String
  roster        RosterTemplate @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  dayOfWeek     Int
  startTime     String
  endTime       String
  roleLabel     String
  requiredSpots Int            @default(1)
  notes         String?

  @@index([rosterId])
  @@map("roster_template_shifts")
}

model Location {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  timezone        String   @default("Europe/Brussels")
  geofenceLat     Decimal? @db.Decimal(10, 7)
  geofenceLng     Decimal? @db.Decimal(10, 7)
  geofenceRadiusM Int?
  // Per-location HMAC secret backing the signed QR clock-in token.
  qrSecret        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shifts Shift[]

  @@index([businessId])
  @@map("locations")
}

model Membership {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       UserRole
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

model Document {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  url         String
  fileName    String
  contentType String?
  sizeBytes   Int?
  expiresOn   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresOn])
  @@map("documents")
}

model ShiftMessage {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([shiftId, createdAt])
  @@map("shift_messages")
}

model DimonaDeclaration {
  id                String       @id @default(cuid())
  shiftId           String
  shift             Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerId          String
  dimonaPeriodId    String?
  status            DimonaStatus @default(PENDING)
  requestPayload    Json?
  responsePayload   Json?
  errorMessage      String?
  outDeclaredAt     DateTime?
  outResponsePayload Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([shiftId])
  @@index([workerId, status])
  @@map("dimona_declarations")
}

/**
 * Per-quarter Belgian Dimona STU (student) declaration. Unlike the per-shift
 * `DimonaDeclaration`, a student worker is declared once per calendar quarter
 * with the total planned hours for that quarter. Planned hours are editable
 * until the last day of the month following the quarter; a quarter must never
 * be declared with 0 hours (it is cancelled instead).
 */
model DimonaStuDeclaration {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  year            Int
  quarter         Int
  plannedHours    Int          @default(0)
  reservedHours   Int          @default(0)
  status          DimonaStatus @default(PENDING)
  dimonaPeriodId  String?
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, businessId, year, quarter])
  @@index([businessId, year, quarter])
  @@map("dimona_stu_declarations")
}

/**
 * Belgian student-worker 650h/calendar-year quota ledger, one row per
 * (user, year). `reservedHours` is the sum of STU planned hours across this
 * employer's quarters; `workedHours` is derived from approved time entries in
 * the year. The national remaining balance is NOT API-readable, so
 * `studentAtWorkBalanceHours` is entered manually from the student's
 * Student@Work attestation when available.
 */
model StudentQuota {
  id                        String    @id @default(cuid())
  userId                    String
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId                String
  business                  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  year                      Int
  reservedHours             Int       @default(0)
  workedHours               Int       @default(0)
  studentAtWorkBalanceHours Int?
  attestationUploadedAt     DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([userId, year])
  @@index([businessId, year])
  @@map("student_quotas")
}

/**
 * Per-business public-holiday override. The Belgian statutory holidays are
 * computed in code ({@link computeBelgianHolidays}); this table only stores a
 * business's *custom* closure days. The effective holiday set used by payroll
 * is the union of the computed defaults and these rows.
 */
model Holiday {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  name       String
  createdAt  DateTime @default(now())

  @@unique([businessId, date])
  @@index([businessId])
  @@map("holidays")
}

model WorkerContract {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractType  ContractType?
  title         String
  body          String?
  fileUrl       String?
  status        ContractStatus @default(DRAFT)
  sentAt        DateTime?
  signedAt      DateTime?
  signatureName String?
  signatureIp   String?
  studentSignatureUrl   String?
  studentSignedAt       DateTime?
  studentSignatureIp    String?
  studentSignerLabel    String?
  employerSignatureUrl  String?
  employerSignedAt      DateTime?
  employerSignatureIp   String?
  employerSignerId      String?
  employerSignerLabel   String?
  startDate       DateTime?
  endDate         DateTime?
  scheduleText    String?
  hourlyWageCents Int?
  jobDescription  String?
  employerSnapshot Json?
  studentSnapshot  Json?
  pdfUrl          String?
  pdfHash         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([businessId, status])
  @@index([userId, status])
  @@map("worker_contracts")
}

model ApiKey {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  hashedKey  String    @unique
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@map("api_keys")
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  events     String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@map("webhook_subscriptions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the random token handed to the user; the raw token is never
  // stored so a database leak cannot be used to reset passwords.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}
